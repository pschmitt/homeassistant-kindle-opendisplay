#!/bin/sh
# Forced SSH command for frontlight control and battery telemetry.
set -eu

brightness=/sys/class/backlight/bl/brightness
saved_level=/opt/opendisplay/frontlight-level
read -r level < "$brightness"

set_level() {
  requested=$1
  # The PW4 driver can set the value even if the write reports a failure.
  printf '%s\n' "$requested" > "$brightness" || :
  read -r applied < "$brightness"
  [ "$applied" -eq "$requested" ]
}

case "${SSH_ORIGINAL_COMMAND:-}" in
  status)
    if [ "$level" -gt 0 ]
    then
      printf '%s\n' ON
    else
      printf '%s\n' OFF
    fi
    ;;
  off)
    if [ "$level" -gt 0 ]
    then
      printf '%s\n' "$level" > "$saved_level"
      set_level 0
    fi
    ;;
  on)
    if [ "$level" -eq 0 ]
    then
      level=297
      if [ -s "$saved_level" ]
      then
        read -r level < "$saved_level"
      fi
      read -r maximum < /sys/class/backlight/bl/max_brightness
      if [ "$level" -gt 0 ] && [ "$level" -le "$maximum" ]
      then
        set_level "$level"
      else
        exit 1
      fi
    fi
    ;;
  'level '*)
    requested=${SSH_ORIGINAL_COMMAND#level }
    read -r maximum < /sys/class/backlight/bl/max_brightness
    case "$requested" in
      ''|*[!0-9]*) exit 2 ;;
    esac
    [ "$requested" -le "$maximum" ] || exit 2
    if [ "$requested" -eq 0 ] && [ "$level" -gt 0 ]
    then
      printf '%s\n' "$level" > "$saved_level"
    fi
    set_level "$requested"
    if [ "$requested" -gt 0 ]
    then
      printf '%s\n' "$requested" > "$saved_level"
    fi
    ;;
  battery)
    battery=/sys/class/power_supply/bd71827_bat
    read -r capacity < "$battery/capacity"
    read -r status < "$battery/status"
    case "$capacity" in
      ''|*[!0-9]*) exit 1 ;;
    esac
    case "$status" in
      Charging|Discharging|Full|'Not charging'|Unknown) ;;
      *) exit 1 ;;
    esac
    charging=false
    if [ "$status" = Charging ]
    then
      charging=true
    fi
    plugged_in=null
    if [ -r /sys/class/power_supply/bd71827_ac/online ]
    then
      read -r online < /sys/class/power_supply/bd71827_ac/online
      case "$online" in
        0) plugged_in=false ;;
        1) plugged_in=true ;;
      esac
    fi
    printf '{"capacity":%s,"status":"%s","charging":%s,"plugged_in":%s}\n' "$capacity" "$status" "$charging" "$plugged_in"
    ;;
  info)
    exec python3 - <<'PY'
import ipaddress
import json
import os
from pathlib import Path
import subprocess


def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def wpa_values(command):
    try:
        result = subprocess.run(
            ["wpa_cli", "-i", "wlan0", command],
            capture_output=True,
            text=True,
            timeout=2,
            check=True,
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    return dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)


firmware = read("/proc/1/root/etc/prettyversion.txt").removeprefix("Kindle ").split()
build = read("/proc/1/root/etc/version.txt").splitlines()
alpine = next(
    (line.removeprefix("VERSION_ID=").strip('"') for line in read("/etc/os-release").splitlines()
     if line.startswith("VERSION_ID=")),
    None,
)
status = wpa_values("status")
wifi = status.get("wpa_state", "")
connected = wifi == "COMPLETED"
try:
    ip_address = str(ipaddress.IPv4Address(status.get("ip_address", ""))) if connected else None
except ipaddress.AddressValueError:
    ip_address = None
rssi = wpa_values("signal_poll").get("RSSI", "") if connected else ""
print(json.dumps({
    "device_type": "Kindle Paperwhite 4 (10th generation)",
    "wifi": "connected" if wifi == "COMPLETED" else (wifi.lower() or "unknown"),
    "ssid": status.get("ssid") if connected else None,
    "bssid": status.get("bssid") if connected else None,
    "ip_address": ip_address,
    "wifi_mac": read("/sys/class/net/wlan0/address") or None,
    "rssi_dbm": int(rssi) if rssi.lstrip("-").isdigit() else None,
    "kindle_firmware": firmware[0] if firmware else None,
    "kindle_build": build[0].removeprefix("System Software Version: ") if build else None,
    "kernel_release": os.uname().release,
    "alpine_version": alpine,
}))
PY
    ;;
  *)
    printf '%s\n' 'Expected Kindle command: on, off, level, status, battery, or info' >&2
    exit 2
    ;;
esac

