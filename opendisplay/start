#!/bin/sh
# Own the display across receiver reloads, and return it to Inkwell on exit.
set -eu

cd /opt/opendisplay
if [ "${OPENDISPLAY_SIGNALS_READY:-}" != 1 ]
then
  exec python3 launch.py "$@"
fi
unset OPENDISPLAY_SIGNALS_READY

exclusive=0
case "${1:-}" in
  --manual) ;;
  ''|--boot-exclusive)
    if [ "${1:-}" = --boot-exclusive ]
    then
      exclusive=1
    fi
    boot_status=0
    python3 settings.py autostart || boot_status=$?
    case "$boot_status" in
      0) ;;
      1) exit 0 ;;
      *) exit "$boot_status" ;;
    esac
    ;;
  *) printf '%s\n' 'Usage: start [--manual|--boot-exclusive]' >&2; exit 2 ;;
esac

if [ ! -x ./kindle-opendisplay ]
then
  printf '%s\n' 'Install the Rust ARMv7 receiver with install.py --receiver-binary.' >&2
  exit 1
fi

mode_lock=/run/opendisplay-mode.lock
mkdir "$mode_lock" || exit 1

home_pid=
resume_home() {
  if [ -n "$home_pid" ] && [ -r "/proc/$home_pid/comm" ] && [ "$(cat "/proc/$home_pid/comm")" = home ]
  then
    kill -CONT "$home_pid"
  fi
  home_pid=
}

release_display() {
  resume_home
  rmdir "$mode_lock"
}
trap release_display EXIT

python3 provision.py

child=
reload=0
stop=0
stop_receiver() {
  if [ -n "$child" ]
  then
    kill -TERM "$child" 2>/dev/null || :
  fi
}

trap 'reload=1; stop_receiver' HUP
trap 'stop=1; stop_receiver' INT TERM

export PYTHONDONTWRITEBYTECODE=1

while :
do
  display_status=0
  python3 settings.py opendisplay || display_status=$?
  case "$display_status" in
    0)
      if [ "$exclusive" -eq 0 ] && [ -z "$home_pid" ]
      then
        home_pid=$(pidof -s home) || {
          printf '%s\n' 'OpenDisplay requires a running Inkwell home process.' >&2
          exit 1
        }
        kill -STOP "$home_pid"
      fi
      ;;
    1)
      if [ "$exclusive" -eq 1 ]
      then
        exit 0
      fi
      resume_home
      ;;
    *) exit "$display_status" ;;
  esac
  ./kindle-opendisplay --supervise &
  child=$!
  if [ "$stop" -eq 1 ] || [ "$reload" -eq 1 ]
  then
    stop_receiver
  fi
  status=0
  wait "$child" || status=$?
  if [ "$stop" -eq 1 ] || [ "$reload" -eq 1 ]
  then
    wait "$child" 2>/dev/null || :
  fi
  child=
  if [ "$stop" -eq 1 ]
  then
    exit 0
  fi
  if [ "$reload" -eq 0 ]
  then
    exit "$status"
  fi
  reload=0
done

