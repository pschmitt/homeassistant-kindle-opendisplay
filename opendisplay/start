#!/bin/sh
# Own the display across receiver reloads, and return it to Inkwell on exit.
set -eu

cd /opt/opendisplay
home_pid=$(pidof -s home)
case "$home_pid" in
  ''|*[!0-9]*)
    printf '%s\n' 'OpenDisplay requires a running Inkwell home process.' >&2
    exit 1
    ;;
esac

mode_lock=/run/opendisplay-mode.lock
mkdir "$mode_lock" || exit 1

resume_home() {
  if [ -r "/proc/$home_pid/comm" ] && [ "$(cat "/proc/$home_pid/comm")" = home ]
  then
    kill -CONT "$home_pid"
  fi
  rmdir "$mode_lock"
}

kill -STOP "$home_pid" || {
  rmdir "$mode_lock"
  exit 1
}
trap resume_home EXIT

child=
reload=0
stop=0
stop_receiver() {
  if [ -n "$child" ]
  then
    kill -TERM "$child" 2>/dev/null || :
  fi
}

trap 'reload=1; stop_receiver' HUP
trap 'stop=1; stop_receiver' INT TERM

export PYTHONPATH=/opt/opendisplay/deps:/opt/opendisplay/deps/usr/lib/python3.14/site-packages
export PYTHONDONTWRITEBYTECODE=1

while :
do
  python3 receiver.py kindle-pw4 device.json frame.bin --render &
  child=$!
  if [ "$stop" -eq 1 ] || [ "$reload" -eq 1 ]
  then
    stop_receiver
  fi
  status=0
  wait "$child" || status=$?
  if [ "$stop" -eq 1 ] || [ "$reload" -eq 1 ]
  then
    wait "$child" 2>/dev/null || :
  fi
  child=
  if [ "$stop" -eq 1 ]
  then
    exit 0
  fi
  if [ "$reload" -eq 0 ]
  then
    exit "$status"
  fi
  reload=0
done

